# YAWAsau Mount v1.4.2 默认设置
#
# 实际使用中的配置文件：/data/adb/dcimswitch/mount.conf
# 如果此文件位于 /data/adb/dcimswitch/mount.conf，保存后会由 inotify 即时应用。若位于模块目录，仅是模板/范例，不会被监听。
#
# ─────────────────────────────────────────────
# ① 主分区设置
# ─────────────────────────────────────────────
# partition：必填。填「分区名称」，不是 /dev/block/... 路径。
# 例如 partition=YAWAsau，模块会自己寻找名称为 YAWAsau 的 by-name 分区。
# 找不到就直接报错，不会猜 sda16、sda17 等实体节点。
partition=YAWAsau

# mount_point：必填。上面那颗分区要挂到哪个目录。
mount_point=/mnt/YAWAsau

# fs：分区格式。
# auto = 自动识别 ext4 或 f2fs（建议）
# 也可以直接填 ext4 或 f2fs。
# 其他格式一律拒绝挂载。
fs=auto

# vendor_gallery_quiesce：厂商相册兼容模式。
# auto  = 默认；Profile 切换 DCIM 前，检测到 HyperOS/MIUI 相册 package 才静默处理。
# off   = 不处理。
# force = 强制按内置相册 package 清单处理。
vendor_gallery_quiesce=auto

# ─────────────────────────────────────────────
# ② 预先创建的文件夹
# ─────────────────────────────────────────────
# 格式：dir=文件夹完整路径|权限策略
# preserve = 只创建/检查，不主动修改原本权限
# media_rw = 首次应用时递归修复共享存储权限（目录与普通文件）；成功后缓存，不在待机扫描
# preserve / bindfs_shared 来源、子项符号链接与嵌套挂载不会被此递归修复修改
# 不需要的 dir= 行可以直接删掉。
dir=/mnt/YAWAsau/Pictures/Screenshots|media_rw
dir=/mnt/YAWAsau/DCIM/Camera|media_rw
dir=/mnt/YAWAsau/DCIM2/Camera|media_rw

# ─────────────────────────────────────────────
# ③ 可切换的挂载来源（Profile）
# ─────────────────────────────────────────────
# 格式：profile=群组名称|当前选项
# 下面代表 camera 群组目前选「daily」。
# WebUI 切换日常/工作时，实际就是修改这一行。
profile=camera|daily

# ─────────────────────────────────────────────
# ④ 挂载项目
# ─────────────────────────────────────────────
# 格式：
# mount=显示名称|User ID|来源文件夹|手机端挂载路径|启用|Profile群组|Profile选项|权限策略|自动创建来源|首次搬移
#
# 每一栏的意思：
# 1. 显示名称：WebUI 显示的名字。可以留空，留空就直接取挂载路径最后一段。
#    例如目标是 /storage/emulated/0/MT2，名称留空时 WebUI 就显示「MT2」。
# 2. User ID：主用户通常是 0；其他 Android 用户填自己的 ID，例如 10。
# 3. 来源文件夹：真正存放数据的位置。可填完整路径；也可填相对路径，会自动接到 mount_point 下。
# 4. 手机端挂载路径：你希望 Android / App 看到的位置。可填 /storage/emulated/<User>/...；也可填相对路径，会自动接到 /storage/emulated/<User>/ 下。
# 5. 启用：1=启用，0=停用。
# 6. Profile群组：不需要切换来源就留空。
# 7. Profile选项：不需要切换来源就留空。
# 8. 权限策略：preserve、media_rw 或 bindfs_shared（bindfs_shared 仅 mount= 支持；dir= 只支持 preserve/media_rw）。
# 9. 自动创建来源：1=来源不存在时自动 mkdir，0=不存在就报错/跳过。
# 10. 首次搬移：none=不搬；once=第一次挂载前，把手机端原有内容非覆盖搬到来源。
#
# 注意：同一个 User、同一个手机端挂载路径，同一时间只能有一个有效来源。

mount=虚拟分区|0|/mnt/YAWAsau/备份|/storage/emulated/0/虚拟分区|1|||media_rw|1|none
mount=Pictures|0|/mnt/YAWAsau/Pictures|/storage/emulated/0/Pictures|1|||media_rw|1|once
mount=QQ|0|/data/media/0/Android/data/com.tencent.mobileqq/Tencent/QQfile_recv|/storage/emulated/0/Download/QQ|1|||preserve|1|none
mount=Telegram|0|/data/media/0/Android/data/tw.nekomimi.nekogram/files/Telegram|/storage/emulated/0/Download/Telegram|1|||preserve|1|none

# camera 群组：daily 与 work 共用同一个 /storage/emulated/0/DCIM。
# profile=camera|daily 时只启用「日常」；切成 work 时只启用「工作」。
mount=日常|0|/mnt/YAWAsau/DCIM|/storage/emulated/0/DCIM|1|camera|daily|media_rw|1|once
mount=工作|0|/mnt/YAWAsau/DCIM2|/storage/emulated/0/DCIM|1|camera|work|media_rw|1|once


# 跨 User 共享范例：如果 User 10 里的普通 App 直接打开文件会 EACCES，可改用 bindfs_shared；需先将自行编译的 bindfs 放到模块 bin/bindfs 或 /data/adb/dcimswitch/native/bin/bindfs。
# 它会在挂载视图中映射 uid/gid/mode/context，不直接递归修改 /mnt/YAWAsau/备份 内既有文件。
# mount=虚拟分区-U10|10|备份|虚拟分区|1|||bindfs_shared|1|none

# 自由挂载范例（默认不启用，需要时取消前面的 #）：
# 名称留空，所以 WebUI 会显示目标最后一段「MT2」。
# mount=|0|MT2|MT2|1|||preserve|1|none
